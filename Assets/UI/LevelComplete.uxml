            <ui:VisualElement style="flex-grow: 1; flex-direction: row; padding-bottom: 0; width: auto; min-width: auto; max-width: none; justify-content: space-between; height: 25px; min-height: 25px; max-height: 25px; -unity-background-scale-mode: stretch-to-fill; align-self: auto; align-items: stretch; background-color: rgba(0, 0, 0, 0); margin-left: 0; margin-right: 0; padding-left: 0;">
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="retry" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;retryButtonUnpressed&apos;); width: 75px; min-width: 75px; max-width: 75px; color: rgba(27, 27, 27, 0); -unity-background-scale-mode: scale-to-fit;">
                    <ui:VisualElement style="flex-grow: initial; width: 70px; flex-direction: row; flex-shrink: initial; background-color: rgb(179, 179, 179); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-right: 5px; height: 25px; min-width: 70px; min-height: 25px; max-width: 70px; max-height: 25px; display: none;">
                        <ui:Label tabindex="-1" text="Retry" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: auto; height: auto; min-width: auto; min-height: auto; max-width: 75px; -unity-text-align: middle-left; white-space: normal;" />
                        <ui:VisualElement style="flex-grow: 1; width: 15px; height: 15px; min-width: 15px; min-height: 15px; max-width: 15px; max-height: 15px; background-image: url(&quot;project://database/Assets/retry.png?fileID=2800000&amp;guid=0dca052449427b3408a1ef2a366652ee&amp;type=3#retry&quot;); margin-left: 10px; align-self: center;" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="nextLevel" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: resource(&apos;nextUnpressed&apos;); width: 75px; min-width: 75px; max-width: 75px; -unity-background-scale-mode: scale-to-fit; color: rgba(27, 27, 27, 0);">
                    <ui:VisualElement name="nextLevel" style="flex-grow: initial; width: 70px; flex-direction: row; flex-shrink: initial; background-color: rgb(179, 179, 179); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-left: 5px; align-self: flex-start; min-width: 70px; max-width: 70px; height: 25px; min-height: 25px; max-height: 25px; display: none;">
                        <ui:Label tabindex="-1" text="Next" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: auto; height: auto; min-width: auto; min-height: auto; max-width: none; -unity-text-align: middle-left;" />
                        <ui:VisualElement style="flex-grow: 1; width: 15px; height: 15px; min-width: 15px; min-height: 15px; max-width: 15px; max-height: 15px; background-image: url(&quot;project://database/Assets/play.png?fileID=2800000&amp;guid=c6bdfa0a02248f64d89e1cd49ba52766&amp;type=3#play&quot;); margin-left: 10px; align-self: center;" />
