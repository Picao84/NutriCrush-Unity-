            <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 100%; height: auto; min-width: 100%; min-height: auto; max-width: 100%; max-height: none; align-self: auto; justify-content: space-around; margin-bottom: 25px; margin-top: 0; -unity-background-scale-mode: stretch-to-fill; -unity-slice-scale: 0; scale: 1.1 1.1; align-items: auto; background-color: rgba(0, 0, 0, 0); flex-direction: column; margin-right: 15px;">
                <ui:Instance template="LevelCompleteBars" name="LevelCompleteBars" style="align-items: auto; align-self: auto; justify-content: flex-start;" />
