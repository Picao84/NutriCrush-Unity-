<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; justify-content: center; align-self: center; background-color: rgba(0, 0, 0, 0.36);">
        <ui:VisualElement style="flex-grow: 0; align-self: center; justify-content: flex-start; background-image: url(&quot;project://database/Assets/settingsBackground.png?fileID=2800000&amp;guid=98cf22e12425af14690c3ece2fb0f97d&amp;type=3#settingsBackground&quot;); -unity-background-scale-mode: scale-to-fit; align-items: stretch; flex-shrink: 0; padding-top: 60px; padding-right: 80px; padding-bottom: 80px; padding-left: 80px; margin-left: 5px;">
            <ui:VisualElement name="VisualElement" style="flex-grow: initial; flex-shrink: initial; flex-direction: row-reverse; margin-top: -56px; padding-top: 0;">
                <ui:VisualElement name="close" style="flex-grow: initial; background-image: resource(&apos;exitRoundUnpressed&apos;); width: 32px; height: 32px; margin-top: 0; flex-direction: column; flex-shrink: initial; margin-right: -17px; margin-left: 0; margin-bottom: 0;" />
            </ui:VisualElement>
            <ui:Label tabindex="-1" text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(254, 254, 254); -unity-font: url(&quot;project://database/Assets/Montserrat-Black.ttf?fileID=12800000&amp;guid=7fa7e9823b0394144a505368a6426a30&amp;type=3#Montserrat-Black&quot;); -unity-font-definition: initial; -unity-text-outline-color: rgb(117, 93, 73); -unity-text-outline-width: 1px; -unity-font-style: normal; font-size: 18px; -unity-text-align: upper-center;" />
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; margin-bottom: 20px; width: auto; min-width: auto; margin-right: 0; margin-left: 0; align-self: auto; justify-content: flex-start; align-items: center; margin-top: 10px;">
                <ui:Label tabindex="-1" text="Sound" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-font: url(&quot;project://database/Assets/Montserrat-Bold.ttf?fileID=12800000&amp;guid=c82d19c6a5fc1b34f8314e7caaba618e&amp;type=3#Montserrat-Bold&quot;); -unity-font-style: bold; color: rgb(117, 93, 73); font-size: 9px; margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-right;" />
                <ui:Slider high-value="100" page-size="0" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; background-image: none; flex-shrink: initial; flex-grow: initial; width: 130px;" />
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; margin-bottom: 20px; margin-top: 10px;">
                <ui:Label tabindex="-1" text="Music" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-font: url(&quot;project://database/Assets/Montserrat-Bold.ttf?fileID=12800000&amp;guid=c82d19c6a5fc1b34f8314e7caaba618e&amp;type=3#Montserrat-Bold&quot;); -unity-font-style: bold; color: rgb(117, 93, 73); font-size: 9px; margin-top: 0; margin-right: 12px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-right;" />
                <ui:Slider high-value="100" style="margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 0; align-items: auto; width: 130px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-bottom: -75px; margin-left: 0; align-self: center; width: 100%; justify-content: space-between; padding-left: 0; margin-top: 50px; padding-bottom: 0; margin-right: 5px;">
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="default" style="background-image: resource(&apos;defaultButtonUnpressed&apos;); -unity-background-scale-mode: scale-to-fit; color: rgba(27, 27, 27, 0); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 46%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 60px;" />
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="save" style="background-image: resource(&apos;saveButtonUnpressed&apos;); -unity-background-scale-mode: scale-to-fit; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgba(27, 27, 27, 0); width: 46%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
