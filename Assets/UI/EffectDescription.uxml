<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: initial; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.59); justify-content: center; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; flex-shrink: initial;">
        <ui:VisualElement name="VisualElement" style="flex-grow: initial; background-image: url(&quot;project://database/Assets/effectPopupBackground.png?fileID=2800000&amp;guid=fd5b5fa745646c8459f166594820e42e&amp;type=3#effectPopupBackground&quot;); -unity-background-scale-mode: scale-to-fit; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: flex-end; flex-shrink: initial; padding-top: 0; padding-right: 40px; padding-bottom: 15px; padding-left: 40px; width: auto; height: auto; align-self: center; align-items: auto;">
            <ui:Button text="&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="closeButton" style="background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-image: resource(&apos;exitRoundUnpressed&apos;); -unity-background-scale-mode: scale-to-fit; width: 28px; height: 28px; margin-top: 3px; margin-right: -11.5px; margin-bottom: 0; margin-left: 0; align-self: flex-end; align-items: auto; flex-shrink: initial; flex-grow: initial;" />
            <ui:VisualElement name="effectImage" style="flex-grow: initial; background-image: resource(&apos;slow_release&apos;); -unity-background-scale-mode: scale-to-fit; width: 30px; align-self: center; flex-shrink: initial; height: 30px; justify-content: flex-start; align-items: stretch; margin-bottom: 0; margin-top: -10px; padding-top: 0; padding-bottom: 0;" />
            <ui:Label tabindex="-1" text="Slow Digestion" parse-escape-sequences="true" display-tooltip-when-elided="true" name="effectName" style="-unity-text-align: upper-center; color: rgb(254, 254, 254); -unity-text-outline-color: rgb(117, 93, 73); -unity-text-outline-width: 5px; font-size: 10px; -unity-font: url(&quot;project://database/Assets/Montserrat-Bold.ttf?fileID=12800000&amp;guid=c82d19c6a5fc1b34f8314e7caaba618e&amp;type=3#Montserrat-Bold&quot;); -unity-font-definition: initial; letter-spacing: -8px; -unity-font-style: bold; text-shadow: 0 0 0 rgb(0, 0, 0); margin-bottom: 0; padding-bottom: 0; flex-shrink: initial; flex-grow: initial; align-self: center;" />
            <ui:Label tabindex="-1" text="The blender slows down in the next 15 seconds." parse-escape-sequences="true" display-tooltip-when-elided="true" name="effectDescription" style="-unity-text-align: upper-center; -unity-font: url(&quot;project://database/Assets/Montserrat-Regular.ttf?fileID=12800000&amp;guid=80bf344a292efb243aed8b9e13f4fdb8&amp;type=3#Montserrat-Regular&quot;); -unity-font-definition: initial; color: rgb(90, 83, 77); font-size: 9px; white-space: normal; align-self: center; margin-left: 0; margin-right: 0; padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; margin-top: 5px; margin-bottom: 5px; justify-content: flex-start; align-items: auto; flex-shrink: initial; flex-grow: initial; display: flex; width: 150px; min-height: 32px; min-width: 150px; -unity-font-style: normal;" />
        </ui:VisualElement>
